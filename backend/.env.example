# String de conexão do MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/buscar-receitas?retryWrites=true&w=majority

# Chave secreta usada para assinar os tokens JWT
JWT_SECRET=sua_chave_secreta

# Porta em que o backend Express vai rodar
PORT=3000

# URL do frontend autorizada no CORS
FRONTEND_URL=http://localhost:5173